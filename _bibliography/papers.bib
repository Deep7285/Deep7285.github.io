@article{kumar2026fsw,
  title     = {Microstructure and Mechanical Properties of Friction Stir Welded 
               {AA6082} Aluminium Alloy and Dual-Phase 780 Steel Dissimilar Joints},
  author    = {Kumar, Deepak and Bauri, Ranjit and Prakash, Tej},
  journal   = {Journal of Manufacturing Processes},
  year      = {2026},
  note      = {Under review},
  selected  = {true},
  abstract  = {Dissimilar welding of steel and aluminium alloys has attracted widespread 
               attention in the automobile industry to make lighter automobile parts for 
               better fuel efficiency and reduced emissions. Friction stir welding (FSW) 
               is a solid-state welding process that can overcome fusion welding issues. 
               The present work focuses on dissimilar FSW of aluminium alloy (AA6082-T6) 
               and dual-phase steel (DP780) in lap configuration. Different process 
               parameters were considered to establish the process parameter window based 
               on microstructural analysis and mechanical property evaluation.}
}

@article{nama2025zr,
  title     = {Microstructural Evolution and Corrosion Kinetics of {X2} {Zr-Nb} 
               Alloy in Simulated {PWR} and {BWR} Environments},
  author    = {Nama, Rajat and Kumar, Deepak and Liang, Xingzhong and Shah, Zaheen 
               and Partezana, Jonna and Frankel, Philipp and Grovenor, Chris 
               and Lozano-Perez, Sergio},
  journal   = {ASTM STP Proceedings},
  year      = {2025},
  note      = {Accepted for publication},
  selected  = {true},
  abstract  = {This study investigates how dissolved oxygen concentration affects aqueous 
               corrosion of X2 Zr-Nb alloy in nuclear environments. Samples exposed to 
               simulated PWR and BWR conditions for 90 days showed that the BWR environment 
               produced 20\% thicker oxides following different growth kinetics. TEM and 
               spectroscopy revealed quantifiable microstructural differences in oxide 
               phase stability, defect formation, and growth kinetics relevant to predicting 
               materials behaviour in varied reactor environments.}
}

@software{nama2025porodet,
  title     = {{PoroDet}: A Python Package for Nano-porosity Detection in {TEM} Images},
  author    = {Nama, Rajat and Kumar, Deepak and Choudhury, Tanmoy 
               and Grovenor, Chris and Lozano-Perez, Sergio},
  year      = {2025},
  doi       = {10.5281/zenodo.19342741},
  url       = {https://github.com/Deep7285/PoroDet},
  note      = {Submitted to Journal of Open Source Software (JOSS)},
  selected  = {true},
  abstract  = {PoroDet is an open-source Python workflow for supervised feature extraction 
               from TEM images. The software provides a task-specific end-to-end pipeline 
               integrating dataset preparation, model training, batch inference, and 
               quantitative post-processing. Originally developed for nanopores in 
               Fresnel-contrast TEM images, the workflow is adaptable to other TEM feature 
               classes through user-supplied annotations. It trains a U-Net encoder-decoder 
               CNN, supporting training from scratch or via fine-tuning.}
}

