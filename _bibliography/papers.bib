@article{kumar2025fsw,
  title     = {Microstructure and Mechanical Properties of Friction Stir Welded AA6082 Aluminium
              Alloy and Dual-Phase 780 Steel Dissimilar Joints},
  author    = {Deepak Kumar, Ranjit Bauri*, Tej Prakash},
  journal   = {Journal of Manufacturing Processes},
  year      = {2026},
  note      = {Under review},
  selected  = {true},
  abstract  = {Dissimilar welding of steel and aluminium alloys has attracted widespread attention in
              the automobile industry to make lighter automobile parts for better fuel efficiency and
              reduced emissions. Fusion welding processes are not suitable for dissimilar welding
              due to various issues. Friction stir welding (FSW) is a solid-state welding process that
              can overcome these issues. The present work focuses on the dissimilar FSW of
              aluminium alloy (AA6082-T6) and dual-phase steel (DP780) of different thicknesses in
              lap configuration. Different process parameters, such as tool rotation speed, transverse
              speed, and plunging depth, were considered to establish the process parameter
              window based on microstructural analysis and mechanical property evaluation. The
              effect of intermetallic compounds (IMCs) formed at the joint interface was also
              evaluated. 1250 rpm, 40 mm/min, and 3 mm plunge depth yielded highest shear
              strength but also resulted in tunnel defects. Increasing the rotation speed to 1500 rpm
              with a concomitant increase in traverse speed (50 mm/min) and plunge depth (3.1 mm)
              eliminated the tunnel defect but resulted in lower shear strength. This can be attributed
              to IMC layer thickness which increased with increasing tool rotation speed.
              Consequently, the weld made with 1750 rpm exhibited lowest strength and elongation.
              The interlocking effect of steel hook fragments that formed in the Al matrix, and a
              refined grain size also contributed to the enhanced strength in the 1250 rpm, 40
              mm/min, and 3 mm sample.}
              }

@article{nama2025zr,
  title     = {Microstructural Evolution and Corrosion Kinetics of X2 Zr-Nb 
               Alloy in Simulated PWR and BWR Environments},
  author    = {Rajat Namaa, Deepak Kumarb, Xingzhong Liangc,d, Zaheen Shahe, Jonna Partezanaf, Philipp Frankelc, 
               Chris Grovenora, Sergio Lozano-Pereza,},
  journal   = {ASTM Proceedings- STP},
  year      = {2025},
  note      = {Accepted for publication},
  selected  = {true}
  abstract  =  {This study investigates how the dissolved oxygen concentration affects 
              the aqueous corrosion of X2 Zr-Nb alloy in nuclear environments. 
              Samples exposed to simulated PWR (310°C/15.5 MPa, <10 ppb O2) and 
              BWR (300°C/8.6 MPa, 8.3 ppm O2) conditions for 90 days showed that 
              the BWR environment produced 20% thicker oxides that followed t0.31 
              kinetics rather than t0.34 in the PWR environment. Transmission electron 
              microscopy and spectroscopy revealed quantifiable microstructural 
              differences: BWR oxides contained 47% tetragonal ZrO2 (versus 2% in 
              PWR), exhibited ~100nm interface undulations (versus ~400nm in PWR), 
              contained triple the nanopore density, and showed faster oxidation of Nb
              rich SPPs. We infer that these differences stem from oxygen vacancy
              mediated mechanisms where rapid Nb oxidation under BWR conditions 
              alters the effect of space charge compensation, influencing phase 
              stability, defect formation and growth kinetics. The findings establish 
              correlations between water chemistry and corrosion microstructure 
              relevant for predicting materials behavior in varied reactor environments.
              }

@software{kumar2025porodet,
  title     = {{PoroDet}: A Python Package for Nano-porosity Detection in {TEM} Images},
  author    = {Nama, R., Kumar, D., Choudhury, T., Grovenor, C., & Lozano-Perez, S.},
  year      = {2026},
  publisher = {JOSS (Journal of Open Source Software)},
  doi       = {10.5281/zenodo.19342741},
  url       = {https://github.com/Deep7285/PoroDet},
  note      = {Submitted to Journal of Open Source Software (JOSS)},
  selected  = {true},
  abstract  = {PoroDet is an open-source Python workflow for supervised feature extraction 
              from transmission electron microscopy (TEM) images. The software provides a 
              task-specific end-to-end pipeline, integrating dataset preparation, model training, 
              batch inference and quantitative post processing within a fully scriptable and reproducible 
              framework. Whilst originally developed for nanopores and nanocracks in Fresnel contrast
              TEM images, the workflow is designed to be adaptable to other TEM feature classes through 
              training with user supplied image mask annotations. TEM images commonly exhibit abstract, 
              acquisition-dependent contrast, strong variability between datasets, and limited availability 
              of annotated training data. PoroDet addresses these constraints by training a standard encoder–decoder 
              convolutional neural network based on the U-Net architecture [1]. The workflow supports the 
              training either from scratch or via fine-tuning (transfer learning), while treating training 
              and data augmentation as standard components of the workflow rather than specialized steps.
              }

